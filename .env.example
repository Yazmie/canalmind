# ============================================================
# CanalMind 环境变量模板
# 用法：cp .env.example .env  然后填入真实值
# ⚠️ .env 已在 .gitignore 中，切勿提交真实密钥
# ============================================================

# ---------- 大模型 ----------
# DeepSeek 开放平台 https://platform.deepseek.com/
#
# ⚠️ 重要：下面这些是**环境变量名**，Spring AI 并不会自动读取它们。
#    Spring AI 实际读的配置键是 `spring.ai.deepseek.api-key` 等
#    （共 23 个，属性名来源：spring-ai-autoconfigure-model-deepseek-1.1.2.jar
#      内的 META-INF/spring-configuration-metadata.json）。
#    因此必须在 application.yml 里显式桥接，否则密钥填了也不生效：
#
#      spring:
#        ai:
#          deepseek:
#            api-key: ${DEEPSEEK_API_KEY}
#            base-url: ${DEEPSEEK_BASE_URL}
#            chat:
#              options:
#                model: ${DEEPSEEK_CHAT_MODEL}
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# ---------- Embedding（决策 C-22：Ollama + 本地 bge-m3）----------
# ⚠️ DeepSeek 开放平台**不提供 embedding 接口**，故 embedding 不由 DeepSeek 提供。
#    早前此处的 `DEEPSEEK_EMBEDDING_MODEL=` 是**空值且无法填出可用值**，
#    于第 2 周确认 C-22 后改用本地 Ollama 模型（零 API 费用、离线可复现）。
#
# 前置条件（需用户手动执行一次）：
#   1) 安装 Ollama           https://ollama.com/download
#   2) 拉取模型              ollama pull bge-m3
#   3) 确认服务可用          curl http://localhost:11434/api/tags
#
# Spring AI 实际读取的配置键（属性名来源：spring-ai-autoconfigure-model-ollama-1.1.2.jar
#   内的 META-INF/spring-configuration-metadata.json，已实测核验，非猜测）：
#     spring.ai.ollama.base-url          （默认 http://localhost:11434）
#     spring.ai.ollama.embedding.model   （本项即 `spring.ai.ollama.embedding.options.model` 的简写）
#
# ⚠️⚠️ 索引与查询必须使用**同一** embedding 模型及版本（C-22 配套硬约束）。
#    本地模型与云 API 混用会导致"测试正常、上线召回率腰斩"（知识库明确点名此坑）。
#    更换模型必须**全量重建索引**，不能增量替换。
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
# bge-m3 输出维度为 1024；建向量表时 `vector(N)` 的 N 必须与此一致
OLLAMA_EMBEDDING_DIMENSION=1024

# ---------- PostgreSQL + PgVector ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=canalmind
POSTGRES_USER=canalmind
POSTGRES_PASSWORD=change-me

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 应用 ----------
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ---------- 可观测性 ----------
# 开发环境设为 1.0 便于检查 Trace 结构；生产按流量调整
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
