<?xml version="1.0" encoding="UTF-8"?>
<!--
  CanalMind 后端（canalmind-api）

  版本决策见 docs/DECISIONS.md C-16：Spring Boot 3.5.9 + Spring AI 1.1.2。

  ⚠️ 两个刻意的写法，不要"顺手改掉"：

  1) 用 spring-boot-dependencies 导入而**不用 spring-boot-starter-parent**：
     本机 Maven 缓存中 starter-parent 最高只有 3.5.7，没有 3.5.9。
     代价是插件版本不再被自动管理，因此下面所有插件都显式写了版本。

  2) spring-ai 构件**逐个写版本号**而不是导入 spring-ai-bom：
     本机缓存中**完全没有 spring-ai-bom**（1.0.0/1.1.0/1.1.2 都没有）。
     联网后可改回 BOM 方式，更易统一升级——但改之前先确认能拉下来。

  离线构建配方（已验证 BUILD SUCCESS）：
     mvn -o -s <settings> -gs <settings> \
         -Daether.enhancedLocalRepository.trackingFilename=_none.repositories compile
  其中 settings.xml 的 mirror id 必须是 huaweicloud（与本地 _remote.repositories 记录一致）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.canalmind</groupId>
  <artifactId>canalmind-api</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>CanalMind</name>
  <description>平陆运河航运物流智能业务助手</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <spring-boot.version>3.5.9</spring-boot.version>
    <spring-ai.version>1.1.2</spring-ai.version>

    <!-- 插件版本：因未用 parent，必须显式声明，且须是本机缓存中已有的版本 -->
    <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
    <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
    <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- ===== Web / SSE ===== -->
    <!--
      SSE 不需要 spring-boot-starter-webflux：
      org.springframework.http.codec.ServerSentEvent 就在 spring-web 里，
      由 starter-web 传递引入。这样可避免拖入整套 Netty。
      依据：知识库《大模型 API 调用工程实践》第 106 行
            "WebMVC + Flux 只是在 Controller 出口用了响应式类型做 SSE，底层仍是 Servlet 容器"。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- ===== 大模型 ===== -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-deepseek</artifactId>
      <version>${spring-ai.version}</version>
    </dependency>

    <!-- ===== 持久化（第 2 周检索通道：PgVector 入库）===== -->
    <!--
      为什么到这里才引入（第 1 周刻意不引，注释保留以示变化）：
      第 1 周交付物是"可流式对话的空壳服务"，那时引入 DataSource 会让应用
      因找不到数据库口令而启动失败，反而破坏"可运行"这一条。
      第 2 周做检索通道，入库/校验必须连库，故此时加入。

      ⚠️ 版本一律交给上面的 spring-boot-dependencies（3.5.9）BOM 管理，**不写版本号**
      （与 starter-web / starter-test 的写法一致）：
        - spring-boot-starter-jdbc → 3.5.9（传递 HikariCP 6.3.3 + spring-jdbc 6.2.15）
        - org.postgresql:postgresql → **42.7.8**（BOM 属性 postgresql.version
          = 42.7.8，见 spring-boot-dependencies-3.5.9.pom 第 159 行）
      已实测本机缓冲仓库（.m2repo）中两者都存在，故离线构建可用。

      ⚠️ 刻意**不引入**的两个：
        - flyway-core：本项目的迁移用 `psql -f` 手工应用（见 docs/进度看板.md §5），
          引入它会让应用启动时自动跑迁移，与"手工应用 + 无迁移账本"的现状冲突；
        - mybatis-plus：属于结构化查询通道（第 3 周），检索通道用不到。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!--
      PostgreSQL JDBC 驱动。用 compile 而非 runtime：PgVectorIngestCli 是独立
      命令行入口，驱动必须出现在 `dependency:build-classpath` 产出的类路径上。
    -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>

    <!-- ===== 检索通道：中文分词（第 2 周第 4 项，决策 C-25）===== -->
    <!--
      为什么必须用 Java 侧分词（而不是交给 PostgreSQL）：
      本机 PG18 实测**没有任何中文分词扩展**（`share/extension` 下 65 个 .control 里
      没有 zhparser / pg_jieba / IK），且上游两个方案都只支持 POSIX 构建
      （zhparser 要先编译 SCWS；pg_jieba 是 C++/cmake 且只在 CentOS7/PG9.6 与 macOS/PG11 测过），
      而本机没有 make/gcc/cmake/nmake。详见 V4 迁移文件头与 docs/DECISIONS.md C-25。

      为什么是 jieba-analysis 而不是 HanLP / ansj：
      ① 它有**自定义词典 API**（本项硬需求：「自定义航运词典」）；
      ② 纯 Java、**零传递依赖**（实测 pom 无 compile 依赖），不拖入 Netty/模型文件那一类包袱；
      ③ 算法是结巴分词（业界通行），Apache-2.0。
      ⚠️ 版本只能写死：它不在 spring-boot-dependencies 的 BOM 里。
      ⚠️ 实测该库的用户词典**必须恰好两列** `词 词频`，写成三列（标准 jieba 的 tag 格式）
         会让词频**静默退回默认值 3.0**，词典几乎失效——见 ShippingDictionary 的严格校验
         与 docs/工程复盘/检索工程/结巴用户词典的列数陷阱.md。
    -->
    <dependency>
      <groupId>com.huaban</groupId>
      <artifactId>jieba-analysis</artifactId>
      <version>1.0.2</version>
    </dependency>

    <!-- ===== 结构化查询段：JSON Schema 校验（决策 C-32） ===== -->
    <!--
      为什么用 networknt/json-schema-validator：
        C-32 定的是「JSON Mode + **服务端** Schema 校验」——校验必须发生在服务端，
        因为我们不能要求模型一定合规（DeepSeek 无 strict 模式的 JSON Schema 强制）。
        知识库《大模型结构化输出》第 161、177–179 行为「反模式」警示：
        只写提示词说「必须输出 JSON」而不做校验，等于把契约交给模型自觉。
      ⚠️ 2.0.0 的 API 与 1.x **完全不同**（包结构重构）：
        1.x 的 JsonSchemaFactory / JsonSchema / SchemaValidatorsConfig / SpecVersion **均已不存在**，
        现行入口是 SchemaRegistry.withDefaultDialect(SpecificationVersion.DRAFT_2020_12)
        → registry.getSchema(JsonNode) → schema.validate(ExecutionContext, JsonNode)
        → ctx.getErrors()。用 javap 实测确认，详见 docs/进度看板.md 第 3 周笔记。
      ⚠️ 传递依赖 com.ethlo.time:itu:1.14.0 是**运行期必需**（RFC3339 format 支持），
        本机缓存已有；joni / graal-sdk / js 是 optional（只在选用 Joni/GraalJS 正则工厂时需要），
        本项目用默认的 JDKRegularExpressionFactory，故不需要它们。
    -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>2.0.0</version>
    </dependency>

    <!-- ===== 测试 ===== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <!--
            Spring Framework 6.1+ 需要保留参数名，否则依赖注入与
            @RequestParam 绑定会退化，启动日志提示
            "Ensure your compiler is configured to use the '-parameters' flag"。
          -->
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>${maven-jar-plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>${maven-resources-plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <id>repackage</id>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
