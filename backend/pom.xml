<?xml version="1.0" encoding="UTF-8"?>
<!--
  CanalMind 后端（canalmind-api）

  版本决策见 docs/DECISIONS.md C-16：Spring Boot 3.5.9 + Spring AI 1.1.2。

  ⚠️ 两个刻意的写法，不要"顺手改掉"：

  1) 用 spring-boot-dependencies 导入而**不用 spring-boot-starter-parent**：
     本机 Maven 缓存中 starter-parent 最高只有 3.5.7，没有 3.5.9。
     代价是插件版本不再被自动管理，因此下面所有插件都显式写了版本。

  2) spring-ai 构件**逐个写版本号**而不是导入 spring-ai-bom：
     本机缓存中**完全没有 spring-ai-bom**（1.0.0/1.1.0/1.1.2 都没有）。
     联网后可改回 BOM 方式，更易统一升级——但改之前先确认能拉下来。

  离线构建配方（已验证 BUILD SUCCESS）：
     mvn -o -s <settings> -gs <settings> \
         -Daether.enhancedLocalRepository.trackingFilename=_none.repositories compile
  其中 settings.xml 的 mirror id 必须是 huaweicloud（与本地 _remote.repositories 记录一致）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.canalmind</groupId>
  <artifactId>canalmind-api</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>CanalMind</name>
  <description>平陆运河航运物流智能业务助手</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <spring-boot.version>3.5.9</spring-boot.version>
    <spring-ai.version>1.1.2</spring-ai.version>

    <!-- 插件版本：因未用 parent，必须显式声明，且须是本机缓存中已有的版本 -->
    <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.3</maven-surefire-plugin.version>
    <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
    <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- ===== Web / SSE ===== -->
    <!--
      SSE 不需要 spring-boot-starter-webflux：
      org.springframework.http.codec.ServerSentEvent 就在 spring-web 里，
      由 starter-web 传递引入。这样可避免拖入整套 Netty。
      依据：知识库《大模型 API 调用工程实践》第 106 行
            "WebMVC + Flux 只是在 Controller 出口用了响应式类型做 SSE，底层仍是 Servlet 容器"。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- ===== 大模型 ===== -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-deepseek</artifactId>
      <version>${spring-ai.version}</version>
    </dependency>

    <!-- ===== 测试 ===== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!--
    注：持久化（PostgreSQL + MyBatis-Plus + Redis）按规格书第 1 周范围**暂不引入**。
    第 1 周交付物是"可流式对话的空壳服务"，此时引入 DataSource 会让应用
    因找不到数据库口令而启动失败，反而破坏"可运行"这一条。
    第 2 周做结构化查询通道与检索通道时再加入。
  -->

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <!--
            Spring Framework 6.1+ 需要保留参数名，否则依赖注入与
            @RequestParam 绑定会退化，启动日志提示
            "Ensure your compiler is configured to use the '-parameters' flag"。
          -->
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>${maven-jar-plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>${maven-resources-plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <id>repackage</id>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
